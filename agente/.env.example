# Copiar a .env y completar. ESTE ARCHIVO .env JAMAS SE SUBE A GITHUB.
SUPABASE_URL=https://api.urbisgroupinmobiliaria.com
SUPABASE_SERVICE_KEY=pega_aqui_tu_sb_secret_...
# Direccion del panel para los botones de Telegram (sin barra final). Sin esto: https://panel.urbisgroupinmobiliaria.com
# PANEL_URL=https://panel.urbisgroupinmobiliaria.com
# Tu numero (con codigo de pais, sin +) para recibir avisos del agente:
ADMIN_PHONE=51XXXXXXXXX
# Hora del barrido diario de cobranza (formato 24h HH:MM)
HORA_COBRANZA=09:00
# Dias de anticipacion del recordatorio
DIAS_ANTES=3
# Cada cuantos dias se re-avisa una cuota VENCIDA
VENCIDAS_CADA_DIAS=4
# Tope de mensajes salientes por dia (anti-baneo)
MAX_ENVIOS_DIA=40
# Poner 1 para correr la cobranza al iniciar (para probar sin esperar la hora)
RUN_NOW=0

# --- AGENTE DE COBRANZA · API OFICIAL DE WHATSAPP (cobranza.js) --------------
# Desde el 27 oct 2026 el numero unico de cobranza es el +51 960 487 000 (Praderas),
# en COEXISTENCIA con Baileys, conectado por el conector de C-Soft (panel.csoft.men).
# Id del numero en Meta (NO el numero de prueba de Meta):
WA_PHONE_NUMBER_ID=575708528962509
# Cuenta de WhatsApp (WABA) que Meta creo al conectar el 960:
WA_WABA_ID=561949730334089
# Token de la conexion del 960. Vive oculto en el PocketBase del panel de C-Soft
# (wa_conexiones.token): Cesar lo saca por ssh y se pega con el script 11,
# directo en la terminal del servidor: no pasa por el chat ni por git.
WA_TOKEN=
# Secreto de la app C-Soft (1610624240443608): con el se FIRMA cada aviso que el
# conector reenvia (X-Hub-Signature-256). Sin el, el webhook rechaza todo (401).
# Lo pega Cesar con el script 11 (migracion/11_cobranza_token_meta.sh).
WA_APP_SECRET=
# Palabra secreta para la verificacion GET del webhook (la hace el conector de
# C-Soft contra Meta; aqui solo queda por compatibilidad):
WA_VERIFY_TOKEN=cambiala-por-una-palabra-larga
# WA_BUSINESS_ID=1808254903534177    (portafolio csoft.pe, el del proveedor; opcional)
# Clave PROPIA de Claude para cobranza (workspace Cobranza). Si falta usa la general:
COBRANZA_ANTHROPIC_API_KEY=

# --- AGENTE DE VENTAS IA (ventas_ia.js, dentro del bot de leads) --------------
# Clave propia de Claude para ventas (opcional: si falta usa ANTHROPIC_API_KEY)
# VENTAS_ANTHROPIC_API_KEY=
# Notas de voz → texto con Groq (console.groq.com → API Keys). Sin ella, el agente
# pide que le escriban. Se prueba con: node transcribir.js prueba
GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3

# --- CONSULTA DE DNI Y RUC (consulta_doc.js, sql/119) -------------------------
# Token de decolecta.com (100 consultas gratis al mes). Se carga con
# migracion/13_consulta_dni_ruc.sh, que lo pide sin mostrarlo. Sin token, el
# nombre se escribe a mano al emitir.
CONSULTA_DOC_TOKEN=
