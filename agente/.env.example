# Copiar a .env y completar. ESTE ARCHIVO .env JAMAS SE SUBE A GITHUB.
SUPABASE_URL=https://api.urbisgroupinmobiliaria.com
SUPABASE_SERVICE_KEY=pega_aqui_tu_sb_secret_...
# Direccion del panel para los botones de Telegram (sin barra final). Sin esto: https://panel.urbisgroupinmobiliaria.com
# PANEL_URL=https://panel.urbisgroupinmobiliaria.com
# Tu numero (con codigo de pais, sin +) para recibir avisos del agente:
ADMIN_PHONE=51XXXXXXXXX
# Hora del barrido diario de cobranza (formato 24h HH:MM)
HORA_COBRANZA=09:00
# Dias de anticipacion del recordatorio
DIAS_ANTES=3
# Cada cuantos dias se re-avisa una cuota VENCIDA
VENCIDAS_CADA_DIAS=4
# Tope de mensajes salientes por dia (anti-baneo)
MAX_ENVIOS_DIA=40
# Poner 1 para correr la cobranza al iniciar (para probar sin esperar la hora)
RUN_NOW=0

# --- AGENTE DE COBRANZA · API OFICIAL DE WHATSAPP (cobranza.js) --------------
# Id del numero de cobranza (+51 986 598 614), NO el numero de prueba de Meta:
WA_PHONE_NUMBER_ID=1316329454896872
# Token del usuario del sistema `agente-cobranza`, caducidad Nunca.
# Se genera en business.facebook.com y se pega aca directo: no pasa por el chat.
WA_TOKEN=
# Palabra secreta que tu eliges; es la misma que se escribe en el webhook de Meta:
WA_VERIFY_TOKEN=cambiala-por-una-palabra-larga
# Opcionales: evitan que el script tenga que adivinar la cuenta de WhatsApp.
# WA_WABA_ID=              (lo dice: node cobranza_meta.js waba)
# WA_BUSINESS_ID=305340166707609    (portafolio Urbis Group)
# Clave PROPIA de Claude para cobranza (workspace Cobranza). Si falta usa la general:
COBRANZA_ANTHROPIC_API_KEY=
