{
  "name": "urbis-control",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:panel": "vite build --outDir dist-panel && node scripts/sitio-publicado.mjs panel",
    "build:publico": "vite build --config vite.publico.config.js && node scripts/sitio-publicado.mjs publico",
    "preview": "vite preview",
    "preview:panel": "vite preview --outDir dist-panel --port 4175",
    "preview:publico": "vite preview --config vite.publico.config.js --port 4174"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mammoth": "^1.12.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "vite": "^6.0.0"
  }
}
